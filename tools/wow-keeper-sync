#!/usr/bin/env python3
"""wow-keeper-sync: companion to the 0DearLordKeeper addon (WoW: Forever beta).

The beta client writes addon saved variables to disk correctly but never loads them. This script
turns what is on disk into addon CODE, which the client does load:
  Declared.lua  which saved-variable names every installed addon declares (from the .toc files)
  Restore.lua   the saved files themselves, wrapped as functions the Keeper runs at login
Run it any time; it is also triggered automatically whenever the game writes its saved files.
Usage: wow-keeper-sync [--out DIR] [--quiet]
       wow-keeper-sync --restore SNAPSHOT ADDON    put an addon's shrunken variables back from a snapshot
       wow-keeper-sync --snapshots                 list the snapshots (newest last)
"""
import os, re, subprocess, sys, tempfile, time

def game_dir():
    """The game folder (the one containing Interface/ and WTF/): $WOW_FOREVER_DIR, or the first
    line of ~/.config/wow-keeper/wow-dir."""
    path = os.environ.get("WOW_FOREVER_DIR")
    cfg = os.path.expanduser("~/.config/wow-keeper/wow-dir")
    if not path and os.path.isfile(cfg): path = open(cfg).readline().strip()
    if not path or not os.path.isdir(os.path.join(path, "Interface", "AddOns")):
        sys.exit("Game folder not configured. Put the path of the folder that contains Interface/ and WTF/\n"
                 "(for the beta: .../World of Warcraft/_classic_beta_) into ~/.config/wow-keeper/wow-dir")
    return path

WOW = game_dir()
ADDONS = os.path.join(WOW, "Interface", "AddOns")
WTF = os.path.join(WOW, "WTF", "Account")
KEEPER = "0DearLordKeeper"
MAX_FILE = 16 * 1024 * 1024
out_dir = os.path.join(ADDONS, KEEPER)
quiet = "--quiet" in sys.argv
if "--out" in sys.argv: out_dir = sys.argv[sys.argv.index("--out") + 1]

def log(msg):
    if not quiet: print(msg)

def skip(addon): return addon.startswith("Blizzard_") or "DearLordKeeper" in addon

def declared():
    account, perchar = {}, {}
    for addon in sorted(os.listdir(ADDONS)):
        folder = os.path.join(ADDONS, addon)
        if not os.path.isdir(folder) or skip(addon): continue
        for toc in (f for f in os.listdir(folder) if f.lower().endswith(".toc")):
            try: text = open(os.path.join(folder, toc), encoding="utf-8", errors="replace").read()
            except OSError: continue
            for key, bucket in (("savedvariables", account), ("savedvariablespercharacter", perchar)):
                for m in re.finditer(r"^##\s*%s\s*:\s*(.+)$" % key, text, re.I | re.M):
                    for var in re.split(r"[,\s]+", m.group(1).strip()):
                        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", var): bucket[var] = addon
    return account, perchar

def lua_ok(path):
    """The file must be valid Lua 5.1, otherwise one bad file would break the whole Restore.lua."""
    for tool in (["luajit", "-bl", path], ["lua5.1", "-e", "assert(loadfile(arg[1]))", path]):
        try: return subprocess.run(tool, capture_output=True, timeout=20).returncode == 0
        except (OSError, subprocess.TimeoutExpired): continue
    return True

def lua_str(s): return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'

def saved_files(folder):
    if not os.path.isdir(folder): return
    for name in sorted(os.listdir(folder)):
        if not name.endswith(".lua"): continue
        addon = name[:-4]
        path = os.path.join(folder, name)
        if skip(addon) or os.path.getsize(path) > MAX_FILE or os.path.getsize(path) < 8: continue
        if lua_ok(path): yield addon, open(path, encoding="utf-8", errors="replace").read()
        else: log(f"  skipped (not valid Lua): {path}")

def build_restore():
    accounts = [os.path.join(WTF, a) for a in os.listdir(WTF) if os.path.isdir(os.path.join(WTF, a, "SavedVariables")) and a != "SavedVariables"]
    if not accounts: return None, 0
    account = max(accounts, key=lambda a: os.path.getmtime(os.path.join(a, "SavedVariables")))
    parts = ["-- Generated by wow-keeper-sync from the saved files on disk. Do not edit.",
             "local R = { account = {}, perchar = {} }"]
    count = 0
    for addon, body in saved_files(os.path.join(account, "SavedVariables")):
        parts.append(f"R.account[{lua_str(addon)}] = function()\n{body}\nend"); count += 1
    for realm in sorted(os.listdir(account)):
        realm_dir = os.path.join(account, realm)
        if realm == "SavedVariables" or not os.path.isdir(realm_dir): continue
        for char in sorted(os.listdir(realm_dir)):
            files = list(saved_files(os.path.join(realm_dir, char, "SavedVariables")))
            if not files: continue
            parts.append(f"R.perchar[{lua_str(char)}] = R.perchar[{lua_str(char)}] or {{}}")
            for addon, body in files:
                parts.append(f"R.perchar[{lua_str(char)}][{lua_str(addon)}] = function()\n{body}\nend"); count += 1
    parts.append("DearLordKeeper_Restore = R\n")
    return "\n".join(parts), count

def write_if_changed(name, text, stamp_line=None):
    path = os.path.join(out_dir, name)
    try: old = open(path, encoding="utf-8").read()
    except OSError: old = None
    strip = (lambda s: re.sub(r"^R\.generated = \d+\n", "", s, flags=re.M)) if stamp_line else (lambda s: s)
    if old is not None and strip(old) == strip(text): return False
    fd, tmp = tempfile.mkstemp(dir=out_dir, prefix="." + name)
    with os.fdopen(fd, "w", encoding="utf-8") as f: f.write(text)
    os.chmod(tmp, 0o644)
    if not lua_ok(tmp):                       # never install a file the game could choke on
        os.unlink(tmp); log(f"  refused to write {name}: generated file is not valid Lua"); return False
    os.replace(tmp, path)                     # atomic: the game sees the old or the new file, never half of one
    return True

HISTORY = os.path.expanduser("~/.local/share/wow-keeper/history")

def blocks(text):
    """A saved file as {variable: its whole 'NAME = {...}' text}, in file order."""
    out, cur, name = {}, [], None
    for line in text.splitlines(keepends=True):
        m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*) = ", line)
        if m:
            if name: out[name] = "".join(cur)
            name, cur = m.group(1), [line]
        else: cur.append(line)
    if name: out[name] = "".join(cur)
    return out

def read(path): return open(path, encoding="utf-8", errors="surrogateescape").read()
def write(path, text): open(path, "w", encoding="utf-8", errors="surrogateescape").write(text)

def shrink_check():
    """A saved file that is suddenly a fraction of its size in the newest snapshot means a session
    started from defaults and overwrote good data (the reason the snapshots exist). Say so loudly."""
    if not os.path.isdir(HISTORY): return
    snaps = sorted(os.listdir(HISTORY))
    if not snaps: return
    newest = os.path.join(HISTORY, snaps[-1])
    for base, _, files in os.walk(newest):
        for f in files:
            if not f.endswith(".lua"): continue
            old_path = os.path.join(base, f)
            live_path = os.path.join(WTF, os.path.relpath(old_path, newest))
            if not os.path.isfile(live_path): continue
            old_size, new_size = os.path.getsize(old_path), os.path.getsize(live_path)
            if old_size >= 4096 and new_size < old_size * 0.2:
                print(f"WARNING: {os.path.relpath(live_path, WTF)} shrank from {old_size} to {new_size} bytes since snapshot {snaps[-1]}.\n"
                      f"         If that was not you resetting the addon, get the data back (game closed):\n"
                      f"         wow-keeper-sync --restore {snaps[-1]} {f[:-4]}")

def game_running():
    try: return "WowB.exe" in subprocess.run(["ps", "-eo", "comm"], capture_output=True, text=True).stdout.split()
    except OSError: return False

def restore(stamp, addon):
    """Replace, in the live saved files of ADDON, every variable whose text is under 20% of its size
    in the snapshot. Newer variables that did not shrink (settings, for example) are kept."""
    if game_running(): sys.exit("The game is running. Close it first: it would overwrite the restored file at logout.")
    snap = os.path.join(HISTORY, stamp)
    if not os.path.isdir(snap): sys.exit(f"No snapshot {stamp}. See: wow-keeper-sync --snapshots")
    done = 0
    for base, _, files in os.walk(snap):
        if addon + ".lua" not in files: continue
        old_path = os.path.join(base, addon + ".lua")
        live_path = os.path.join(WTF, os.path.relpath(old_path, snap))
        if not os.path.isfile(live_path): print(f"  {live_path}: no live file, skipped"); continue
        live_text = read(live_path); live_b, snap_b = blocks(live_text), blocks(read(old_path))
        for var, old_block in snap_b.items():
            cur = live_b.get(var)
            if cur is None or len(cur) < len(old_block) * 0.2:
                live_text = live_text.replace(cur, old_block, 1) if cur is not None else live_text + old_block
                print(f"  {var}: {len(cur) if cur else 0} -> {len(old_block)} bytes"); done += 1
        if done:
            backup = live_path + time.strftime(".bak-%Y%m%d-%H%M")
            os.replace(live_path, backup); write(live_path, live_text)
            if not lua_ok(live_path): os.replace(backup, live_path); sys.exit("  restored file is not valid Lua, put the original back")
            print(f"  wrote {os.path.relpath(live_path, WTF)} (original kept as {os.path.basename(backup)})")
    if not done: print(f"  nothing to restore: no variable of {addon} is smaller than in the snapshot")

def history():
    """Rolling snapshots of the third-party saved files: insurance against a session that started
    from defaults and then overwrote good data. At most one snapshot per 15 minutes, 40 kept."""
    import shutil
    root = HISTORY
    os.makedirs(root, exist_ok=True)
    existing = sorted(os.listdir(root))
    if existing and time.time() - os.path.getmtime(os.path.join(root, existing[-1])) < 900: return
    dest = os.path.join(root, time.strftime("%Y%m%d-%H%M%S"))
    n = 0
    for base, _, files in os.walk(WTF):
        if os.path.basename(base) != "SavedVariables": continue
        for f in files:
            if f.endswith(".lua") and not skip(f[:-4]):
                target = os.path.join(dest, os.path.relpath(base, WTF))
                os.makedirs(target, exist_ok=True); shutil.copy2(os.path.join(base, f), target); n += 1
    for old in existing[:-39]: shutil.rmtree(os.path.join(root, old), ignore_errors=True)
    log(f"history: snapshot of {n} saved files -> {dest}")

def main():
    if not os.path.isdir(out_dir): sys.exit(f"Keeper addon folder not found: {out_dir}")
    if "--snapshots" in sys.argv:
        for d in sorted(os.listdir(HISTORY)) if os.path.isdir(HISTORY) else []: print(d)
        return
    if "--restore" in sys.argv:
        i = sys.argv.index("--restore")
        if len(sys.argv) < i + 3: sys.exit("Usage: wow-keeper-sync --restore SNAPSHOT ADDON")
        restore(sys.argv[i + 1], sys.argv[i + 2])
    shrink_check()
    history()
    account, perchar = declared()
    lines = ["-- Generated by wow-keeper-sync from the addons' .toc files. Do not edit.", "DearLordKeeper_Declared = { account = {", ]
    lines += [f"  [{lua_str(v)}] = {lua_str(a)}," for v, a in sorted(account.items())]
    lines += ["}, perchar = {"] + [f"  [{lua_str(v)}] = {lua_str(a)}," for v, a in sorted(perchar.items())] + ["} }", ""]
    changed_d = write_if_changed("Declared.lua", "\n".join(lines))
    text, count = build_restore()
    if text is None: text, count = "DearLordKeeper_Restore = { account = {}, perchar = {} }\n", 0
    text = text.replace("local R = { account = {}, perchar = {} }", "local R = { account = {}, perchar = {} }\nR.generated = %d" % int(time.time()), 1)
    changed_r = write_if_changed("Restore.lua", text, stamp_line=True)
    log(f"declared: {len(account)} account-wide + {len(perchar)} per-character variables; restore: {count} saved files"
        f"{'' if (changed_d or changed_r) else ' (nothing changed)'}")

main()
